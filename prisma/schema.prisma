generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id   Int     @id @default(autoincrement())
  nom  RoleNom @unique
  user User[]
}

model User {
  id              String               @id @default(cuid())
  name            String
  email           String               @unique @db.VarChar(255)
  emailVerified   Boolean              @default(false)
  image           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  dateInscription DateTime             @default(now())
  prenom          String?
  roleId          Int?
  telephone       String?              @unique
  avis            Avis[]
  devisConseiller Devis[]              @relation("ConseillerDevis")
  devis           Devis[]              @relation("ClientDevis")
  favoris         Favori[]
  factures        Invoice[]
  notifications   Notification[]
  paiements       Paiement[]
  transactions    PaymentTransaction[]
  reservations    Reservation[]
  accounts        Account[]
  sessions        Session[]
  role            Role?                @relation(fields: [roleId], references: [id])

  @@map("user")
}

model Theme {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  circuits Circuit[]
}

model Region {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  circuits Circuit[]
}

model Circuit {
  id                  Int            @id @default(autoincrement())
  titre               String
  description         String?
  dureeJours          Int?
  prixEstime          Decimal?       @db.Decimal(10, 2)
  nbPlacesDisponibles Int            @default(0)
  dateDebut           DateTime?
  estGroupe           Boolean        @default(false)
  themeId             Int?
  regionId            Int?
  slug                String         @unique
  dateFin             DateTime?
  lieuDepartNom       String?
  lieuDepartLat       Decimal?       @db.Decimal(10, 7)
  lieuDepartLng       Decimal?       @db.Decimal(10, 7)
  lieuArriveeNom      String?
  lieuArriveeLat      Decimal?       @db.Decimal(10, 7)
  lieuArriveeLng      Decimal?       @db.Decimal(10, 7)
  deletedAt           DateTime?
  avis                Avis[]
  region              Region?        @relation(fields: [regionId], references: [id])
  theme               Theme?         @relation(fields: [themeId], references: [id])
  devis               Devis[]
  etapes              Etape[]
  favoris             Favori[]
  images              ImageCircuit[]
  reservations        Reservation[]
}

model ImageCircuit {
  id        Int     @id @default(autoincrement())
  url       String
  legende   String?
  ordre     Int?
  circuitId Int
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@index([circuitId])
}

model Hebergement {
  id      Int     @id @default(autoincrement())
  nom     String
  type    String?
  etoiles Int?
  adresse String?
  etape   Etape?
}

model Etape {
  id            Int         @id @default(autoincrement())
  ordre         Int
  ville         String?
  description   String?
  circuitId     Int
  hebergementId Int         @unique
  activites     Activite[]
  circuit       Circuit     @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  hebergement   Hebergement @relation(fields: [hebergementId], references: [id])
}

model Activite {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  duree       Int?
  prix        Decimal? @db.Decimal(10, 2)
  etapeId     Int
  etape       Etape    @relation(fields: [etapeId], references: [id], onDelete: Cascade)
}

model Devis {
  id                    Int          @id @default(autoincrement())
  dateDemande           DateTime     @default(now())
  nombrePersonnes       Int          @default(1)
  commentaireClient     String?
  commentaireConseiller String?
  montantTotal          Decimal?     @db.Decimal(10, 2)
  statut                StatutDevis  @default(en_cours)
  circuitId             Int
  userId                String
  activites             String[]     @default([])
  ados                  Int          @default(0)
  adultes               Int          @default(1)
  budgetMax             Decimal?     @db.Decimal(10, 2)
  budgetMin             Decimal?     @db.Decimal(10, 2)
  dateDebutSouhaitee    DateTime?
  dateFinSouhaitee      DateTime?
  dureeFlexible         Boolean?     @default(false)
  enfants               Int          @default(0)
  enfantsAge            String?
  newsletter            Boolean?     @default(false)
  nom                   String?
  prenom                String?
  regime                String?
  regimePrecision       String?
  regionIds             Int[]        @default([])
  source                String?
  telephone             String?
  themeIds              Int[]        @default([])
  transport             String[]     @default([])
  typeHebergement       String?
  typeVoyage            String[]     @default([])
  conseillerId          String?
  dateDebutConfirmee    DateTime?
  dateFinConfirmee      DateTime?
  deletedAt             DateTime?
  detailsCalcul         Json?
  circuit               Circuit      @relation(fields: [circuitId], references: [id])
  conseiller            User?        @relation("ConseillerDevis", fields: [conseillerId], references: [id])
  user                  User         @relation("ClientDevis", fields: [userId], references: [id])
  reservation           Reservation?
}

model Reservation {
  id               Int                  @id @default(autoincrement())
  dateReservation  DateTime             @default(now())
  montantFinal     Decimal?             @db.Decimal(10, 2)
  statut           StatutReservation    @default(confirmee)
  devisId          Int?                 @unique
  circuitId        Int?
  createdAt        DateTime             @default(now())
  dateDebut        DateTime?
  dateFin          DateTime?
  nbVoyageurs      Int                  @default(1)
  status           ReservationStatus    @default(BROUILLON)
  updatedAt        DateTime             @updatedAt
  userId           String?
  placesReleasedAt DateTime?
  deletedAt        DateTime?
  factures         Invoice[]
  paiement         Paiement?
  paiements        PaymentTransaction[]
  circuit          Circuit?             @relation(fields: [circuitId], references: [id])
  devis            Devis?               @relation(fields: [devisId], references: [id], onDelete: Restrict)
  user             User?                @relation(fields: [userId], references: [id])
}

model ModePaiement {
  id        Int        @id @default(autoincrement())
  nom       String     @unique
  paiements Paiement[]
}

model Paiement {
  id                   Int          @id @default(autoincrement())
  montant              Decimal      @db.Decimal(10, 2)
  datePaiement         DateTime     @default(now())
  referenceTransaction String?      @unique
  reservationId        Int?         @unique
  modeId               Int
  userId               String
  mode                 ModePaiement @relation(fields: [modeId], references: [id])
  reservation          Reservation? @relation(fields: [reservationId], references: [id])
  user                 User         @relation(fields: [userId], references: [id])
}

model Avis {
  id          Int      @id @default(autoincrement())
  note        Int
  commentaire String?
  dateAvis    DateTime @default(now())
  estModere   Boolean  @default(false)
  circuitId   Int
  userId      String
  circuit     Circuit  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([circuitId])
  @@index([userId])
}

model Favori {
  id        Int      @id @default(autoincrement())
  dateAjout DateTime @default(now())
  circuitId Int
  userId    String
  circuit   Circuit  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, circuitId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  titre     String
  message   String?
  dateEnvoi DateTime @default(now())
  lu        Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lu])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PaymentProvider {
  id           String               @id @default(cuid())
  name         String               @unique
  isActive     Boolean              @default(true)
  config       Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions PaymentTransaction[]
}

model PaymentTransaction {
  id                    String           @id @default(cuid())
  amount                Decimal          @db.Decimal(10, 2)
  currency              String           @default("MGA")
  status                PaymentStatus    @default(PENDING)
  method                PaymentMethod
  providerId            String
  providerRef           String?          @unique
  reservationId         Int
  userId                String
  expiresAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  notificationToken     String?
  providerPaymentMethod String?
  logs                  PaymentLog[]
  provider              PaymentProvider  @relation(fields: [providerId], references: [id])
  reservation           Reservation      @relation(fields: [reservationId], references: [id])
  user                  User             @relation(fields: [userId], references: [id])
  webhooks              PaymentWebhook[]

  @@index([reservationId])
  @@index([providerRef])
  @@index([status])
  @@index([userId])
}

model Invoice {
  id            String        @id @default(cuid())
  numeroFacture String        @unique
  status        InvoiceStatus @default(DRAFT)
  amount        Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal?      @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  reservationId Int
  userId        String
  fileUrl       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  currency      String        @default("MGA")
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PaymentLog {
  id            String             @id @default(cuid())
  transactionId String
  action        String
  data          Json?
  createdAt     DateTime           @default(now())
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id])
}

model PaymentWebhook {
  id            String              @id @default(cuid())
  transactionId String?
  provider      String
  payload       Json
  isProcessed   Boolean             @default(false)
  error         String?
  createdAt     DateTime            @default(now())
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id])
}

enum RoleNom {
  client
  conseiller
  admin
}

enum StatutDevis {
  en_cours
  en_modification
  valide
  accepte
  refuse
  reserve
}

enum StatutReservation {
  confirmee
  annulee
  terminee
}

enum ReservationStatus {
  BROUILLON
  EN_ATTENTE
  CONFIRMEE
  PAYEE
  TERMINEE
  ANNULEE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  PAPI
  BINANCE_PAY
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}
