generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id   Int     @id @default(autoincrement())
  nom  RoleNom @unique
  user User[]
}

model User {
  // 🔐 Champs Better Auth (obligatoires)
  id            String   @id @default(cuid())
  name          String
  email         String   @unique @db.VarChar(255)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 🧑‍💼 Champs métier (ex-`Utilisateur`)
  prenom          String?
  telephone       String?  @unique
  dateInscription DateTime @default(now())

  // 🔗 Rôle (relation vers Role)
  roleId Int?
  role   Role? @relation(fields: [roleId], references: [id])

  // 🔗 Relations métier
  devis          Devis[]              @relation("ClientDevis")
  devisConseiller Devis[]              @relation("ConseillerDevis")
  paiements      Paiement[]
  avis          Avis[]
  favoris       Favori[]
  notifications Notification[]
  reservations  Reservation[]
  transactions  PaymentTransaction[]
  factures      Invoice[]

  // 🔗 Relations Better Auth
  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Theme {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  circuits Circuit[]
}

model Region {
  id       Int       @id @default(autoincrement())
  nom      String    @unique
  circuits Circuit[]
}

model Circuit {
  id                  Int            @id @default(autoincrement())
  titre               String
  slug                String         @unique
  description         String?
  dureeJours          Int?
  prixEstime          Decimal?       @db.Decimal(10, 2)
  nbPlacesDisponibles Int            @default(0)
  dateDebut           DateTime?
  dateFin             DateTime?
  estGroupe           Boolean        @default(false)

  // Lieu de départ (nom + coordonnées GPS)
  lieuDepartNom       String?
  lieuDepartLat       Decimal?       @db.Decimal(10, 7)
  lieuDepartLng       Decimal?       @db.Decimal(10, 7)

  // Lieu d'arrivée (nom + coordonnées GPS)
  lieuArriveeNom      String?
  lieuArriveeLat      Decimal?       @db.Decimal(10, 7)
  lieuArriveeLng      Decimal?       @db.Decimal(10, 7)
  themeId             Int?
  regionId            Int?
  avis                Avis[]
  region              Region?        @relation(fields: [regionId], references: [id])
  theme               Theme?         @relation(fields: [themeId], references: [id])
  devis               Devis[]
  etapes              Etape[]
  favoris             Favori[]
  images              ImageCircuit[]
  reservations        Reservation[]

  deletedAt           DateTime?
}

model ImageCircuit {
  id        Int     @id @default(autoincrement())
  url       String
  legende   String?
  ordre     Int?
  circuitId Int
  circuit   Circuit @relation(fields: [circuitId], references: [id], onDelete: Cascade)

  @@index([circuitId])
}

model Hebergement {
  id      Int     @id @default(autoincrement())
  nom     String
  type    String?
  etoiles Int?
  adresse String?
  etape   Etape?
}

model Etape {
  id            Int         @id @default(autoincrement())
  ordre         Int
  ville         String?
  description   String?
  circuitId     Int
  hebergementId Int         @unique
  activites     Activite[]
  circuit       Circuit     @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  hebergement   Hebergement @relation(fields: [hebergementId], references: [id])
}

model Activite {
  id          Int      @id @default(autoincrement())
  nom         String
  description String?
  duree       Int?
  prix        Decimal? @db.Decimal(10, 2)
  etapeId     Int
  etape       Etape    @relation(fields: [etapeId], references: [id], onDelete: Cascade)
}

model Devis {
  id        Int      @id @default(autoincrement())
  userId       String
  user         User        @relation("ClientDevis", fields: [userId], references: [id])
  conseillerId String?
  conseiller   User?       @relation("ConseillerDevis", fields: [conseillerId], references: [id])
  circuitId    Int
  circuit      Circuit     @relation(fields: [circuitId], references: [id], onDelete: Restrict)

  // Champs existants
  dateDemande           DateTime    @default(now())
  statut                StatutDevis @default(en_cours)
  nombrePersonnes       Int         @default(1)
  commentaireClient     String?
  commentaireConseiller String?
  montantTotal          Decimal?    @db.Decimal(10, 2)
  // Snapshot du chiffrage serveur scellé lors de la validation (breakdown détaillé)
  detailsCalcul         Json?

  // Nouveaux champs pour le formulaire enrichi
  prenom             String?
  nom                String?
  telephone          String?
  dateDebutSouhaitee DateTime?
  dateFinSouhaitee   DateTime?
  dateDebutConfirmee DateTime?
  dateFinConfirmee   DateTime?
  dureeFlexible      Boolean?  @default(false)
  adultes            Int       @default(1)
  enfants            Int       @default(0)
  ados               Int       @default(0)
  enfantsAge         String? // ex: "4, 7, 10"
  typeHebergement    String? // hotel, luxe, lodge, etc.
  regime             String? // vegetarien, vegan, etc.
  regimePrecision    String?
  budgetMin          Decimal?  @db.Decimal(10, 2)
  budgetMax          Decimal?  @db.Decimal(10, 2)
  source             String? // moteur, reseau, ami, etc.
  newsletter         Boolean?  @default(false)

  // Pour stocker les listes (thèmes, régions, activités, transport, type voyage)
  // PostgreSQL supporte les tableaux, on peut les utiliser
  themeIds   Int[]    @default([])
  regionIds  Int[]    @default([])
  typeVoyage String[] @default([]) // ["Aventure", "Détente"]
  activites  String[] @default([]) // ["Randonnée", "Plongée"]
  transport  String[] @default([]) // ["4x4", "Avion"]

  reservation Reservation?
  deletedAt   DateTime?
}

model Reservation {
  id              Int      @id @default(autoincrement())
  dateReservation DateTime @default(now())
  montantFinal    Decimal? @db.Decimal(10, 2)

  // Compatibilité et Nouveaux statuts
  status ReservationStatus @default(BROUILLON)
  statut StatutReservation @default(confirmee)

  // Devis optionnel
  devisId Int?   @unique
  devis   Devis? @relation(fields: [devisId], references: [id], onDelete: Restrict)

  // Nouveaux champs
  circuitId   Int?
  circuit     Circuit?  @relation(fields: [circuitId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  dateDebut   DateTime?
  dateFin     DateTime?
  nbVoyageurs Int       @default(1)

  paiement  Paiement?
  paiements PaymentTransaction[]
  factures  Invoice[]

  deletedAt        DateTime?
  // Verrou idempotent : posé lors de la libération des places.
  // Si non-null, les places ont déjà été restituées → toute tentative
  // de double libération est rejetée atomiquement par Prisma.
  placesReleasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModePaiement {
  id        Int        @id @default(autoincrement())
  nom       String     @unique
  paiements Paiement[]
}

model Paiement {
  id                   Int          @id @default(autoincrement())
  montant              Decimal      @db.Decimal(10, 2)
  datePaiement         DateTime     @default(now())
  referenceTransaction String?      @unique
  reservationId        Int?         @unique
  userId               String
  modeId               Int
  mode                 ModePaiement @relation(fields: [modeId], references: [id])
  reservation          Reservation? @relation(fields: [reservationId], references: [id])
  user                 User         @relation(fields: [userId], references: [id])
}

model Avis {
  id          Int      @id @default(autoincrement())
  note        Int
  commentaire String?
  dateAvis    DateTime @default(now())
  estModere   Boolean  @default(false)
  userId      String
  circuitId   Int
  circuit     Circuit  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([circuitId])
  @@index([userId])
}

model Favori {
  id        Int      @id @default(autoincrement())
  dateAjout DateTime @default(now())
  userId    String
  circuitId Int
  circuit   Circuit  @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, circuitId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  titre     String
  message   String?
  dateEnvoi DateTime @default(now())
  lu        Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lu])
}

enum RoleNom {
  client
  conseiller
  admin
}

enum StatutDevis {
  en_cours
  en_modification
  valide
  accepte
  refuse
  reserve
}

enum StatutReservation {
  confirmee
  annulee
  terminee
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// NOUVEAUX MODÈLES (RESERVATION & PAIEMENT)
// ==========================================

enum ReservationStatus {
  BROUILLON
  EN_ATTENTE
  CONFIRMEE
  PAYEE
  TERMINEE
  ANNULEE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  PAPI
  BINANCE_PAY
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

model PaymentProvider {
  id           String               @id @default(cuid())
  name         String               @unique // ex: 'binance', 'bank_transfer', 'stripe'
  isActive     Boolean              @default(true)
  config       Json?
  transactions PaymentTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model PaymentTransaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("MGA")
  status      PaymentStatus   @default(PENDING)
  method      PaymentMethod
  providerId  String
  provider    PaymentProvider @relation(fields: [providerId], references: [id])
  providerRef String?         @unique

  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  expiresAt DateTime?

  notificationToken     String?
  providerPaymentMethod String?

  logs     PaymentLog[]
  webhooks PaymentWebhook[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([providerRef])
  @@index([status])
  @@index([userId])
}

model Invoice {
  id            String        @id @default(cuid())
  numeroFacture String        @unique
  status        InvoiceStatus @default(DRAFT)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("MGA")
  taxAmount     Decimal?      @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)

  reservationId Int
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  fileUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime?
  validUntil      DateTime?
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentLog {
  id            String             @id @default(cuid())
  transactionId String
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  action        String
  data          Json?
  createdAt     DateTime           @default(now())
}

model PaymentWebhook {
  id            String              @id @default(cuid())
  transactionId String?
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id])
  provider      String
  payload       Json
  isProcessed   Boolean             @default(false)
  error         String?
  createdAt     DateTime            @default(now())
}
