# APPLICATION

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# URL publique utilisée par le client (metadataBase, liens de partage, retour paiement)
# En production : https://domaine-vercel
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# VERCEL BLOB STORAGE
# Token Vercel Blob (Dashboard Vercel → Storage → Blob → Settings)
# Requis en production pour les uploads d'images et le proxy /api/images/[filename]
BLOB_READ_WRITE_TOKEN=""

# DATABASE - POSTGRESQL
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/mon_voyage"

# BETTER AUTH
BETTER_AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# PAPI.MG - PAYMENT

# API key fournie par Papi.mg
PAPI_API_KEY=""
# URL API Papi
PAPI_BASE_URL="https://app.papi.mg/dashboard/api"
# URL publique du Webhook Papi.mg pour recevoir les notifications
# En local avec tunnel : https://<public-url>/api/payment/webhook/papi
# En production : https://<domaine>/api/payment/webhook/papi
PAPI_WEBHOOK_URL=""
# Mode test (true/false). Par défaut: activé hors production uniquement.
# En production, le définir explicitement à true ne créerait que des liens de test.
PAPI_TEST_MODE="true"

# BANK TRANSFER

# Coordonnées bancaires utilisées pour les virements manuels
BANK_IBAN=""
BANK_BIC=""
BANK_ACCOUNT_NAME=""
BANK_NAME=""

# BINANCE PAY

# À renseigner uniquement si Binance Pay est activé
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_MERCHANT_ID=""
BINANCE_BASE_URL=""

# PAYMENT

# Durée de validité des liens de paiement en minutes
PAYMENT_EXPIRATION_MINUTES=15

# UPLOAD

# Taille maximale d'un fichier uploadé en Mo
MAX_UPLOAD_SIZE_MB=5

# CRON — P0.3 Expiration automatique des réservations

# Secret partagé pour protéger l'endpoint interne /api/internal/expire-reservations.
# Générer avec : openssl rand -hex 32
# Utilisation : Authorization: Bearer <CRON_SECRET>
# Compatible Vercel Cron (ajouter aussi dans les env vars Vercel).
CRON_SECRET=""